###################################################################################################
# AFK KICKER MODULE
#
#    AFK.Enabled
#        Description: Enable/Disable the AFK kicker module.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

AFK.Enabled = 1

#    AFK.CheckInterval
#        Description: Time (in milliseconds) between checks for AFK players.
#        Default:     30000 - (30 seconds)

AFK.CheckInterval = 30000

#    AFK.KickTime
#        Description: Time (in milliseconds) a player can be AFK before being kicked.
#        Default:     1800000 - (30 minutes)

AFK.KickTime = 1800000

#    AFK.KickGM
#        Description: Whether to kick Game Masters (GM) who are AFK.
#        Default:     0 - (Do not kick GMs)
#                     1 - (Kick GMs like normal players)

AFK.KickGM = 0

###################################################################################################
# LOGGING
#
#    Logger.modules.afk
#        Description: Logging for the AFK kicker module.
#        Default:     3,Console Server

Logger.modules.afk = 3,Console Server
